    "@types/react-dom": "^19.1.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "license-checker": "^25.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
