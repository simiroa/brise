    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@xyflow/react": "^12.11.2",
    "chrono-node": "^2.10.1",
    "d3-geo": "^3.1.1",
    "html-to-image": "^1.11.13",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^6.4.1",
    "motion": "^14.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
