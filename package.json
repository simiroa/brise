{
  "name": "brise",
  "private": true,
  "version": "0.5.3",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "brise": "cli/brise.mjs"
  },
  "scripts": {
    "cli": "node cli/brise.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:settings": "node scripts/check-settings-keys.mjs",
    "check:surface": "node scripts/check-surface-contract.mjs",
    "check:css-vars": "node scripts/check-css-vars.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:clones": "node scripts/check-clones.mjs",
    "check:window-caps": "node scripts/check-window-capabilities.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs",
    "check:contract": "node scripts/check-command-contract.mjs",
    "check:silent": "node scripts/check-silent-catch.mjs",
    "check:sync-commands": "node scripts/check-sync-commands.mjs",
    "check:served": "node scripts/check-served.mjs",
    "check:bundle": "node scripts/bench/check-bundle.mjs",
    "bench": "node scripts/bench/run.mjs --suite rust",
    "bench:app": "node scripts/bench/run.mjs --suite app",
    "check": "npm run check:i18n && npm run check:settings && npm run check:surface && npm run check:css-vars && npm run check:colors && npm run check:clones && npm run check:window-caps && npm run check:features && npm run check:type-scale && npm run check:contract && npm run check:silent && npm run check:sync-commands",
    "gen": "node scripts/gen-commands.mjs",
    "gen:notices": "node scripts/gen-notices.mjs",
    "eval:automation": "node scripts/automation-eval/run.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
