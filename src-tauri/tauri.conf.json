{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brise",
  "version": "0.5.4",
  "identifier": "com.brise.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brise",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org asset: http://asset.localhost https://asset.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; font-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' https://tiles.openfreemap.org ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; frame-src 'self' asset: http://asset.localhost https://asset.localhost https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**",
          "$APPDATA/workspace_bg/**",
          "$APPDATA/emoji/**",
          "$APPDATA/fonts/**",
          "$APPDATA/slide_previews/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/simiroa/brise/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERUI5MzZEMjkxMTc4OUEKUldTYWVCRXBiWlByM1ZaRE9Na2VyVlJ5eHRMQVVYbmdFdzhuTmF3SGxGYjZ6Y085bmVMQzZLRWkK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/THIRD-PARTY-NOTICES.html": "THIRD-PARTY-NOTICES.html",
      "../cli/brise.mjs": "cli/brise.mjs",
      "../cli/mcp.mjs": "cli/mcp.mjs",
      "../cli/commands.gen.json": "cli/commands.gen.json",
      "../cli/agent-tools.gen.json": "cli/agent-tools.gen.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
